{
  "name": "wartaqi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.2.0",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run lint && npm run build && npm run check:artifact",
    "verify:ui": "vite build --mode verification && playwright test",
    "verify:release": "npm run verify && npm run security:files && npm run verify:ui && npm run security:history && npm run security:audit",
    "check:artifact": "tsx scripts/check-artifact.ts",
    "setup:security": "tsx scripts/setup-security.ts",
    "security:staged": "tsx scripts/security.ts staged",
    "security:history": "tsx scripts/security.ts history",
    "security:files": "tsx scripts/security.ts files",
    "security:audit": "node scripts/check-picomatch.cjs && tsx scripts/audit.ts",
    "preview": "vite preview --host 127.0.0.1",
    "db:migrate": "tsx scripts/neon-admin.ts migrate",
    "neon:admin": "tsx scripts/neon-admin.ts",
    "verify:neon:live": "tsx scripts/verify-neon-live.ts",
    "prepare": "husky",
    "agent:lab": "tsx scripts/agent-lab.ts",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/cimd": "1.7.25",
    "@better-auth/mcp": "1.7.25",
    "@better-auth/oauth-provider": "1.7.25",
    "@dnd-kit/collision": "0.5.3",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.25",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@better-auth/core": "1.7.25",
    "picomatch": "4.0.7",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest-runner": "npm:vitest@^4.1.12"
  }
}
