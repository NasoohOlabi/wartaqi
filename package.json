{
  "name": "wartaqi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "bun test ./tests",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run format:check && bun run test && bun run lint && bun run build && bun run check:artifact",
    "verify:ui": "vite build --mode verification && playwright test",
    "verify:release": "bun run verify && bun run security:files && bun run verify:ui && bun run security:history && bun run security:audit",
    "check:artifact": "bun scripts/check-artifact.ts",
    "setup:security": "bun scripts/setup-security.ts",
    "security:staged": "bun scripts/security.ts staged",
    "security:history": "bun scripts/security.ts history",
    "security:files": "bun scripts/security.ts files",
    "security:audit": "node scripts/check-picomatch.cjs && bun scripts/audit.ts",
    "preview": "vite preview --host 127.0.0.1",
    "db:migrate": "bun run scripts/neon-admin.ts migrate",
    "neon:admin": "bun run scripts/neon-admin.ts",
    "verify:neon:live": "bun run scripts/verify-neon-live.ts",
    "prepare": "husky",
    "agent:lab": "bun scripts/agent-lab.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/cimd": "1.7.28",
    "@better-auth/mcp": "1.7.28",
    "@better-auth/oauth-provider": "1.7.28",
    "@dnd-kit/collision": "0.5.3",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/functions": "^0.11.0",
    "@socket.io/bun-engine": "^0.1.2",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "1.7.28",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "picomatch": "4.0.7",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  },
  "patchedDependencies": {
    "picomatch@4.0.7": "patches/picomatch@4.0.7.patch"
  }
}
