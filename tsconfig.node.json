{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "functions/**/*.ts",
    "server/**/*.ts",
    "telegram/**/*.ts",
    "neon.ts",
    "tests",
    "e2e",
    "scripts",
    "shared"
  ]
}
